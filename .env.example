# ─────────────────────────────────────────────────────────────
# Escolha UM provedor de IA: Gemini Developer API ou Vertex AI
# ─────────────────────────────────────────────────────────────

# ── Opção A: Gemini Developer API (chave) ──
# Obtenha em https://aistudio.google.com/app/apikey
# Atenção: sujeito à cota free-tier (ex.: 20 req/dia por modelo).
GEMINI_API_KEY=SUA_CHAVE_API_DO_GEMINI

# ── Opção B: Vertex AI (service account, SOMENTE variáveis de ambiente) ──
# Recomendado para evitar a cota free-tier. Copie os campos do JSON da
# service account para as variáveis abaixo (sem usar o arquivo):
#   - project_id     -> GOOGLE_CLOUD_PROJECT
#   - client_email   -> GOOGLE_CLIENT_EMAIL
#   - private_key    -> GOOGLE_PRIVATE_KEY (em UMA linha; mantenha os \n literais)
# A service account precisa do papel "Vertex AI User" e da API Vertex AI habilitada.
# GOOGLE_GENAI_USE_VERTEXAI=true
# GOOGLE_CLOUD_PROJECT=seu-projeto-gcp
# GOOGLE_CLOUD_LOCATION=us-central1
# GOOGLE_CLIENT_EMAIL=sua-sa@seu-projeto.iam.gserviceaccount.com
# GOOGLE_PRIVATE_KEY=-----BEGIN PRIVATE KEY-----\nMIIE...\n-----END PRIVATE KEY-----\n
